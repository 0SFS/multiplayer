{
  "name": "@0sfs/multiplayer",
  "version": "0.1.0",
  "private": true,
  "description": "0SFS multiplayer world and optional serverless browser session: aircraft poses, bullet bursts and missile guidance.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./availability": {
      "source": "./src/availability.ts",
      "default": "./src/availability.ts"
    },
    "./ballistics": {
      "source": "./src/ballistics.ts",
      "default": "./src/ballistics.ts"
    },
    "./geodetic": {
      "source": "./src/geodetic.ts",
      "default": "./src/geodetic.ts"
    },
    "./guidance": {
      "source": "./src/guidance.ts",
      "default": "./src/guidance.ts"
    },
    "./posePlayout": {
      "source": "./src/posePlayout.ts",
      "default": "./src/posePlayout.ts"
    },
    "./protocol": {
      "source": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./sessionWorld": {
      "source": "./src/sessionWorld.ts",
      "default": "./src/sessionWorld.ts"
    },
    "./sharedSettings": {
      "source": "./src/sharedSettings.ts",
      "default": "./src/sharedSettings.ts"
    },
    "./package.json": "./package.json",
    "./serverlessSession": {
      "source": "./src/serverlessSession.ts",
      "default": "./src/serverlessSession.ts"
    },
    "./invitation": {
      "source": "./src/invitation.ts",
      "default": "./src/invitation.ts"
    }
  },
  "devDependencies": {
    "vitest": "4.1.6"
  },
  "peerDependencies": {
    "@0sfs/rc": "0.1.0"
  }
}
